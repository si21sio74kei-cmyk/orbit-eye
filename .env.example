# 轨道之眼 OrbitEye 配置 — 复制本文件为 .env 并填入真实值即可（.env 已被 .gitignore 忽略，不会提交到仓库）
# 所有变量均有默认值；不创建 .env 也能以 DEMO 模式运行（自动使用演示回退数据）。

# NASA API Key（申请: https://api.nasa.gov/）— 留空则使用 DEMO_KEY（有调用频率限制）
NASA_API_KEY=DEMO_KEY

# le-systeme-solaire.net 天文 API Key（可选，已内置可用默认值）
SOLAR_SYSTEM_API_KEY=56f9bdf9-e7cc-4f25-b1bf-7b16735edfd0

# 太阳系数据接口地址（一般无需改动）
SOLAR_SYSTEM_API_URL=https://api.le-systeme-solaire.net/rest/bodies/

# 服务监听端口
PORT=5500

# 默认观测点（澳门）坐标
MACAO_LAT=22.1989
MACAO_LON=113.5491
